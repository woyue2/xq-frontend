# ==============================
# 通用参数（本地/云都要改）
# ==============================
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET=CHANGE_ME_32_PLUS_RANDOM_STRING
JWT_EXPIRES_IN=7d

# 后端镜像策略
# 本地构建：kpqa-backend:local + never
# 云端拉仓库镜像：registry.example.com/kpqa-backend:tag + always
BACKEND_IMAGE=kpqa-backend:local
BACKEND_PULL_POLICY=never

# ==============================
# 本地环境示例（WSL）
# ==============================
# SITE_ADDRESS=localhost
# FRONTEND_DIST_PATH=/mnt/c/Users/Administrator/Downloads/zsxq-4/dist
# CORS_ORIGIN=http://localhost
# BACKEND_URL=http://localhost

# ==============================
# 云服务器示例（Ubuntu）
# ==============================
SITE_ADDRESS=example.com
FRONTEND_DIST_PATH=/opt/zsxq-4/dist
CORS_ORIGIN=https://example.com
BACKEND_URL=https://example.com

# ==============================
# 后端运行参数
# ==============================
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://kpqa:${POSTGRES_PASSWORD}@postgres:5432/kpqa_db?connection_limit=5
REDIS_URL=redis://redis:6379
AUDIO_BASE_DIR=/data/audio
