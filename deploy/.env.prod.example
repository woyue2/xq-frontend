NODE_ENV=production
PORT=3000

# 把下面密码替换成你自己的强密码
DATABASE_URL=postgresql://kpqa:REPLACE_DB_PASSWORD@postgres:5432/kpqa_db?connection_limit=5
REDIS_URL=redis://redis:6379

# 至少 16 位，建议 32 位以上随机字符串
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# 必须是你的正式前端域名（HTTPS）
CORS_ORIGIN=https://172.245.82.114.sslip.io

# 建议配置：后端对外地址
BACKEND_URL=https://172.245.82.114.sslip.io

# 录音文件目录（与 compose 中 volume 保持一致）
AUDIO_BASE_DIR=/data/audio
