FROM node:20-alpine

WORKDIR /app

# 安装 tsx 用于直接运行 TypeScript
RUN npm install -g tsx

# 先复制 package 与 Prisma schema，确保安装依赖时可生成 Prisma Client
COPY backend/package*.json ./
COPY backend/prisma ./prisma

# 安装依赖（包括 devDependencies）
RUN npm ci
RUN npx prisma generate

# 复制源代码（排除 backend/.env，避免生产镜像读取开发环境变量）
COPY backend/src ./src
COPY backend/script ./script
COPY backend/tsconfig.json ./tsconfig.json

# 暴露端口
EXPOSE 3000

# 直接使用 tsx 运行（跳过构建）
CMD ["tsx", "src/server.ts"]
