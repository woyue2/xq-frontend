# ============================================
# Supabase 配置（必需）
# 从 Supabase Dashboard → Project Settings → API 获取
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# 后端 API 配置（必需）
# ============================================
# 数据库连接（Supabase Postgres）
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# JWT 密钥（用于用户认证）
JWT_SECRET=your-jwt-secret-key-here

# ============================================
# 文件上传配置（必需）
# ============================================
# 图片上传到 imgurl.org OSS
OSS_UPLOAD_BASE_URL=https://api.imgurl.org/upload
OSS_UPLOAD_TOKEN=your-oss-token-here

# 音频上传到 Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ============================================
# AI 审核配置（可选，不填则跳过 AI 审核）
# ============================================
VITE_AI_AUDIT_ENABLED=true
VITE_AI_API_KEY=your-ai-api-key
VITE_AI_MODEL=glm-4-flash

# ============================================
# 应用配置
# ============================================
VITE_APP_NAME=KPQA
VITE_APP_DESCRIPTION=中学数学答疑平台
