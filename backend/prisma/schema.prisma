generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  phone      String   @unique
  nickname   String
  avatar     String?
  role       String
  grade      String?
  age        Int?
  school     String?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isActive   Boolean  @default(true)
  isBanned   Boolean  @default(false)

  // 关系
  whitelist  UserWhitelist?
  loginLogs  LoginLog[]

  @@index([phone])
  @@index([role])
}

/// 短信验证码记录表
model VerificationCode {
  id          String   @id @default(cuid())
  phone       String
  code        String
  type        String              // login | register
  expireAt    DateTime
  used        Boolean  @default(false)
  errorCount  Int      @default(0) // 错误次数
  lockedUntil DateTime?           // 多次错误后锁定时间
  createdAt   DateTime @default(now())
  usedAt      DateTime?

  @@index([phone, type])
}

/// 白名单表（用于严格控制注册/登录权限）
model UserWhitelist {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String
  role         String
  grade        String?
  validUntil   DateTime?
  notes        String?
  isRegistered Boolean  @default(false)
  userId       String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  registeredAt DateTime?
  deletedAt    DateTime?
  deletedBy    String?

  user         User?    @relation(fields: [userId], references: [id])

  @@index([role])
  @@index([isRegistered])
}

/// 刷新令牌表（可选，用于管理 Refresh Token）
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// 登录日志
model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

/// 问题表
model Question {
  id              String   @id @default(cuid())
  title           String
  content         String?
  subject         String?
  tags            String[]
  difficulty      String?
  status          String   @default("pending")
  isGoodQuestion  Boolean  @default(false)
  isPinned        Boolean  @default(false)
  score           Int?
  aiResult        String?
  likes           Int      @default(0)
  favorites       Int      @default(0)
  comments        Int      @default(0)
  answers         Int      @default(0)
  authorId        String
  authorName      String
  authorAvatar    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([isGoodQuestion])
}

/// 回答表
model Answer {
  id           String   @id @default(cuid())
  questionId   String
  content      String
  images       String[]
  audioUrl     String?
  authorId     String
  authorName   String
  authorAvatar String?
  likes        Int      @default(0)
  status       String   @default("pending")
  aiResult     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([questionId, status, createdAt])
}

/// 评论表
model Comment {
  id           String   @id @default(cuid())
  questionId   String
  content      String
  image        String?
  authorId     String
  authorName   String
  authorAvatar String?
  status       String   @default("pending")
  aiResult     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([questionId, status, createdAt])
}

/// 点赞表（问题/回答）
model Like {
  id         String   @id @default(cuid())
  userId     String
  targetType String   // 'question' | 'answer'
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
}

/// 收藏表（问题）
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

/// 通知表
model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String   // 'answer' | 'comment' | 'audit_result' | 'system'
  title      String
  content    String?
  targetType String?
  targetId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

/// 行为日志表（埋点）
model BehaviorLog {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  eventType  String
  metadata   Json?
  path       String?
  referrer   String?
  userAgent  String?
  ipAddress  String?
  clientTime DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

/// 审核日志表
model AuditLog {
  id         String   @id @default(cuid())
  auditorId  String
  targetType String   // 'question' | 'answer' | 'comment'
  targetId   String
  action     String   // 'approve' | 'reject' | 'ban'
  reason     String?
  createdAt  DateTime @default(now())

  @@index([auditorId])
  @@index([targetType, targetId])
}

