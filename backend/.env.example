# 后端环境变量配置模板
# 复制此文件为 .env 并填写实际值

NODE_ENV=development
PORT=4000

# CORS 配置 - 允许的前端域名（生产环境禁止使用通配符 *）
# 多个域名用逗号分隔，如：http://localhost:5173,https://staging.example.com
CORS_ORIGIN=http://localhost:5173

# 数据库连接
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis 连接（可选）
REDIS_URL=redis://localhost:6379

# JWT 密钥 - 生产环境必须更换为强随机字符串（至少 32 位）
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# OSS 图片上传配置
OSS_UPLOAD_BASE_URL=https://your-oss-provider.com/api/upload
OSS_UPLOAD_TOKEN=your-oss-upload-token

# AI 审核服务配置
AI_AUDIT_BASE_URL=https://ai-service.example.com/api
AI_AUDIT_PROVIDER_NAME=your-provider
AI_INTERNAL_TOKEN=your-internal-callback-token

# 后端 URL（用于 AI 回调地址构建）
BACKEND_URL=http://localhost:4000

# 本地音频文件目录（建议生产环境指向持久卷挂载路径，如 /data/audio）
# 修改原因：显式暴露音频目录配置，减少部署时依赖默认值导致的路径不一致风险。
# ⚠️ 不确定因素：若为多节点部署，/data/audio 需由共享存储提供，否则跨节点可能读不到文件。
AUDIO_BASE_DIR=static/audio

# 可选：AI 回调 IP 白名单（逗号分隔，如 "1.2.3.4,5.6.7.8"）
# AI_CALLBACK_IP_ALLOWLIST=

# 可选：禁用测试端点（生产环境建议开启）
# DISABLE_TEST_ENDPOINTS=true

# 可选：登录时强制校验白名单（默认关闭）
# AUTH_STRICT_WHITELIST_FOR_LOGIN=true
