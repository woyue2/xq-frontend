{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth.ts"
    },
    {
      "source": "/api/questions/:path*",
      "destination": "/api/questions.ts"
    },
    {
      "source": "/api/answers/:path*",
      "destination": "/api/answers.ts"
    },
    {
      "source": "/api/comments/:path*",
      "destination": "/api/comments.ts"
    },
    {
      "source": "/api/subjects/:path*",
      "destination": "/api/subjects.ts"
    },
    {
      "source": "/api/upload/:path*",
      "destination": "/api/upload.ts"
    },
    {
      "source": "/((?!api/|@|src/|node_modules/|static/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/subjects",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . :!backend/"
}
