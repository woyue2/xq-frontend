{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth.ts?module=auth"
    },
    {
      "source": "/api/social/:path*",
      "destination": "/api/social.ts?module=interactions"
    },
    {
      "source": "/api/notifications/:path*",
      "destination": "/api/social.ts?module=notifications"
    },
    {
      "source": "/api/core/:path*",
      "destination": "/api/core.ts?module=health"
    },
    {
      "source": "/api/family/:path*",
      "destination": "/api/family.ts?module=parent"
    },
    {
      "source": "/api/upload/:path*",
      "destination": "/api/upload.ts?module=upload"
    },
    {
      "source": "/api/config/:path*",
      "destination": "/api/config/subjects.ts"
    },
    {
      "source": "/api/questions/:path*",
      "destination": "/api/questions.ts"
    },
    {
      "source": "/api/content/:path*",
      "destination": "/api/content.ts"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin.ts"
    },
    {
      "source": "/((?!api/|@|src/|node_modules/|static/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . :!backend/"
}
