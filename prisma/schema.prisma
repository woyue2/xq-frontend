generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                     String         @id @default(cuid())
  phone                                  String         @unique
  nickname                               String
  avatar                                 String?
  role                                   String
  grade                                  String?
  age                                    Int?
  school                                 String?
  expiresAt                              DateTime?
  createdAt                              DateTime       @default(now())
  updatedAt                              DateTime       @updatedAt
  isActive                               Boolean        @default(true)
  isBanned                               Boolean        @default(false)
  passwordHash                           String?
  name                                   String?
  LoginLog                               LoginLog[]
  ParentChild_ParentChild_childIdToUser  ParentChild[]  @relation("ParentChild_childIdToUser")
  ParentChild_ParentChild_parentIdToUser ParentChild[]  @relation("ParentChild_parentIdToUser")
  UserWhitelist                          UserWhitelist?

  @@index([phone])
  @@index([role])
}

model Question {
  id                    String                  @id @default(cuid())
  title                 String
  content               String?
  subject               String?
  tags                  String[]
  difficulty            String?
  status                String                  @default("pending")
  isGoodQuestion        Boolean                 @default(false)
  isPinned              Boolean                 @default(false)
  score                 Int?
  aiResult              String?
  likes                 Int                     @default(0)
  favorites             Int                     @default(0)
  comments              Int                     @default(0)
  answers               Int                     @default(0)
  authorId              String
  authorName            String
  authorAvatar          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  images                String[]
  notUnderstoodCount    Int                     @default(0)
  understoodCount       Int                     @default(0)
  answerList            Answer[]
  commentList           Comment[]
  QuestionUnderstanding QuestionUnderstanding[]

  @@index([subject])
  @@index([tags])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([isGoodQuestion])
  @@index([status, createdAt])
}

model Answer {
  id           String    @id @default(cuid())
  questionId   String
  content      String
  images       String[]
  audioUrl     String?
  authorId     String
  authorName   String
  authorAvatar String?
  likes        Int       @default(0)
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  aiResult     String?
  deletedAt    DateTime?
  question     Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, status, createdAt])
}

model Comment {
  id           String    @id @default(cuid())
  questionId   String
  content      String
  image        String?
  authorId     String
  authorName   String
  authorAvatar String?
  status       String    @default("pending")
  aiResult     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  question     Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, status, createdAt])
}

model Subject {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  order       Int      @default(0)
  enabled     Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topics      Topic[]
}

model Topic {
  id         String   @id @default(cuid())
  subjectKey String
  value      String
  label      String
  order      Int      @default(0)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  subject    Subject  @relation(fields: [subjectKey], references: [key], onDelete: Cascade)

  @@unique([subjectKey, value])
  @@index([subjectKey])
}

model AuditLog {
  id         String   @id
  auditorId  String
  targetType String
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([auditorId])
  @@index([targetType, targetId])
}

model BehaviorLog {
  id         String    @id
  userId     String?
  sessionId  String?
  eventType  String
  metadata   Json?
  path       String?
  referrer   String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  clientTime DateTime?

  @@index([createdAt])
  @@index([eventType])
  @@index([userId])
}

model Favorite {
  id         String   @id
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([questionId])
  @@index([userId])
}

model Like {
  id         String   @id
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
}

model LoginLog {
  id        String   @id
  userId    String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Notification {
  id         String   @id
  userId     String
  type       String
  title      String
  content    String?
  targetType String?
  targetId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isRead])
  @@index([userId])
}

model ParentChild {
  id                              String   @id
  parentId                        String
  childId                         String
  createdAt                       DateTime @default(now())
  User_ParentChild_childIdToUser  User     @relation("ParentChild_childIdToUser", fields: [childId], references: [id])
  User_ParentChild_parentIdToUser User     @relation("ParentChild_parentIdToUser", fields: [parentId], references: [id])

  @@unique([parentId, childId])
  @@index([childId])
  @@index([parentId])
}

model QuestionDimension {
  id                      String                    @id
  key                     String                    @unique
  name                    String
  enabled                 Boolean                   @default(true)
  multiSelect             Boolean                   @default(false)
  description             String?
  order                   Int                       @default(0)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  QuestionDimensionOption QuestionDimensionOption[]
}

model QuestionDimensionOption {
  id                String            @id
  dimensionKey      String
  value             String
  label             String
  order             Int               @default(0)
  enabled           Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  QuestionDimension QuestionDimension @relation(fields: [dimensionKey], references: [key], onDelete: Cascade)

  @@index([dimensionKey])
  @@index([value])
}

model QuestionUnderstanding {
  id         String   @id
  questionId String
  userId     String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserWhitelist {
  id           String    @id
  phone        String    @unique
  name         String
  role         String
  grade        String?
  validUntil   DateTime?
  notes        String?
  isRegistered Boolean   @default(false)
  userId       String?   @unique
  createdAt    DateTime  @default(now())
  registeredAt DateTime?
  deletedAt    DateTime?
  deletedBy    String?
  updatedAt    DateTime
  User         User?     @relation(fields: [userId], references: [id])

  @@index([isRegistered])
  @@index([role])
}

model VerificationCode {
  id          String    @id
  phone       String
  code        String
  type        String
  expireAt    DateTime
  used        Boolean   @default(false)
  errorCount  Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  @@index([phone, type])
}
